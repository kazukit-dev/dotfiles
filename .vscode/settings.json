{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.gabi.pkgs"
      },
      "options": {
        "nix-darwin": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.gabi.options"
        },
        "home-manager-darwin": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.gabi.options.home-manager.users.type.getSubOptions []"
        },
        "flake-parts": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").debug.options"
        },
        "flake-parts2": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").currentSystem.options"
        },
        "nixpkgs": {
          "expr": "{ lib = (builtins.getFlake \"${workspaceFolder}\").inputs.nixpkgs.lib; }"
        }
      }
    }
  },
  "cSpell.words": [
    "awscli",
    "cachix",
    "cmux",
    "deadnix",
    "gabi",
    "ghostty",
    "gomi",
    "karabiner",
    "kazukit",
    "manaflow",
    "nani",
    "niks",
    "nixfmt",
    "nixos",
    "nixpkgs",
    "numtide",
    "oxfmt",
    "pkgs",
    "shfmt",
    "statix",
    "substituters",
    "taplo",
    "treefmt",
    "yazi"
  ]
}
